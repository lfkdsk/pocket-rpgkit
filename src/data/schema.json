{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lfkdsk/pocket-rpgkit/blob/main/src/data/schema.json",
  "title": "Pocket RPG Kit project format v1",
  "$comment": "Format version v1; see src/data/CHANGELOG.md. The normative format marker on every document is \"format\": \"rpgkit-project/v1\".",
  "description": "Self-owned RPG kit data format. Tile ids are 'sheet.cell' strings; each sheet is one cooked TILESET pak entry (16x16 cells). Time-bearing commands use SECONDS of virtual time; the runtime converts via simulationHz, so data stays hz-portable.",
  "type": "object",
  "required": ["format", "title", "tileSize", "start", "sheets", "items"],
  "oneOf": [
    { "required": ["maps"] },
    { "required": ["mapIndex"] }
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "rpgkit-project/v1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tileSize": { "type": "integer", "enum": [16] },
    "start": { "$ref": "#/$defs/transferTarget" },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project-wide runtime options. Every field is optional; an absent field keeps the v1 behavior.",
      "properties": {
        "messageBlocksPlayer": { "type": "boolean", "description": "While any fiber's text or choices box is open (a parallel page's included), the player cannot move and no action or playerTouch page starts; autorun and parallel pages keep running. Default false." },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxPerItem": { "type": "integer", "minimum": 1, "maximum": 999999, "description": "Max count of a single item id the backpack holds; default 99." },
            "maxKinds": { "type": "integer", "minimum": 1, "maximum": 999999, "description": "Max number of distinct item ids the backpack holds; absent means unlimited." }
          },
          "description": "T2-10/B1 engine-level backpack tunables."
        }
      }
    },
    "initialGold": { "type": "integer", "minimum": 0 },
    "playerName": { "type": "string", "minLength": 1, "maxLength": 24, "description": "Default name substituted for the {name} text token in a new playthrough." },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sheet" }
    },
    "sprites": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/spriteDef" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "commonEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/commonEvent" }
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/map" }
    },
    "mapIndex": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapIndexEntry" },
      "description": "Large-project map manifest. MapDef payloads are loaded independently through MapRepository."
    },
    "mapManifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mapSchemaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },

  "$defs": {
    "tileId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.[0-9]+$",
      "description": "Sheet id, '.', zero-based cell index in the cooked sheet grid."
    },
    "cellOrNull": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/tileId" }]
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pak", "cols", "rows"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "pak": { "type": "string", "description": "TILESET pak entry file (cooked via repro/tools/cook-tileset.ts)." },
        "cols": { "type": "integer", "minimum": 1, "maximum": 256 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 256 },
        "defaultPassage": { "enum": ["pass", "block"] },
        "block": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Cells that block all directions (defaultPassage=pass sheets)."
        },
        "pass": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Cells that are walkable despite defaultPassage=block."
        },
        "dirBlock": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "enum": ["down", "left", "right", "up"] },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": "Map key is the cell index (as string); value lists the cell's blocked edge directions: each blocks both leaving that cell through the edge and entering it through that edge from outside."
        },
        "dirEdges": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enter": {
                "type": "array",
                "items": { "enum": ["down", "left", "right", "up"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "exit": {
                "type": "array",
                "items": { "enum": ["down", "left", "right", "up"] },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "description": "Map key is the cell index (as string); one-sided directional passage. 'enter' lists directions from which the cell may NOT be entered (a step crosses that edge INTO the cell); 'exit' lists directions in which the cell may NOT be left. Unlike dirBlock each rule guards only its own cell, so asymmetric/one-way edges (jump-down ledges, one-way doors) are expressible; the undirected dirBlock keeps its meaning and both apply."
        }
      }
    },
    "spriteDef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "src"],
          "properties": {
            "kind": { "const": "image" },
            "src": { "type": "string", "description": "PNG baked as an IMG pak entry (16x16 for static characters)." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "atlases", "frames", "step"],
          "properties": {
            "kind": { "const": "walker" },
            "atlases": {
              "type": "object",
              "required": ["down", "left", "right", "up"],
              "additionalProperties": false,
              "properties": {
                "down": { "type": "string" },
                "left": { "type": "string" },
                "right": { "type": "string" },
                "up": { "type": "string" }
              }
            },
            "frames": { "type": "integer", "minimum": 1, "maximum": 8 },
            "step": { "type": "integer", "minimum": 1, "maximum": 60, "description": "Virtual frames each walk frame is held." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sheet"],
          "properties": {
            "kind": { "const": "walker" },
            "sheet": { "type": "string", "description": "Build-time source sheet id/path, sliced into deterministic static facing/pose frames; the runtime does not load it." },
            "h": { "type": "integer", "enum": [16, 32], "description": "Frame height in pixels; defaults to 32. Width is always 16." },
            "cols": { "type": "integer", "minimum": 3, "maximum": 32, "description": "Source sheet columns; defaults to 3." },
            "rows": { "type": "integer", "minimum": 4, "maximum": 32, "description": "Source sheet rows; defaults to 4." }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sprite"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "sprite": { "$ref": "#/$defs/tileId" },
        "usable": { "type": "boolean" },
        "price": { "type": "integer", "minimum": 0, "description": "Shop price. A shop's goods entry may override it for buying, and override its own sellPrice for selling; a shop with no such override sells at floor(price/2)." },
        "sellable": { "type": "boolean", "description": "Whether this item can be sold for gold at all. Absent defaults to true whenever its effective sell price is > 0; an effective sell price of 0 is never sellable regardless of this flag." }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sprite"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "sprite": { "type": "string", "description": "Key in project.sprites." },
        "moveSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      }
    },
    "mapIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "entry", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 256 },
        "height": { "type": "integer", "minimum": 1, "maximum": 256 },
        "entry": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "width", "height", "sheets", "ground", "events"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "width": { "type": "integer", "minimum": 1, "maximum": 256 },
        "height": { "type": "integer", "minimum": 1, "maximum": 256 },
        "sheets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "ground": {
          "type": "array",
          "description": "Row-major, length width*height; null is a blocking void.",
          "items": { "$ref": "#/$defs/cellOrNull" }
        },
        "upper": {
          "type": "array",
          "description": "Row-major star layer (drawn above characters, always walkable); sparse [[index, tileId], ...].",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/tileId" }]
          },
          "uniqueItems": true
        },
        "passage": {
          "type": "array",
          "description": "Per-cell passage overrides: [index, 'pass'|'block']. Applied after sheet flags (doors over walls).",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [{ "type": "integer", "minimum": 0 }, { "enum": ["pass", "block"] }]
          },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "pages"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1, "description": "Area width in tiles; default 1. The event occupies the w×h rectangle from (x,y): playerTouch fires on entry into ANY cell, action fires when the faced or occupied cell is inside." },
        "h": { "type": "integer", "minimum": 1, "description": "Area height in tiles; default 1." },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "commands"],
      "properties": {
        "condition": { "$ref": "#/$defs/pageCondition" },
        "trigger": { "enum": ["action", "playerTouch", "autorun", "parallel"] },
        "sprite": { "type": ["string", "null"], "description": "Key in project.sprites; null = no character (touch trigger tile only)." },
        "blocks": { "type": "boolean", "description": "true = the event body blocks movement (closed gates); default false = below-characters, walkable, touch fires on entry (MV priorityType 0 semantics)." },
        "moveType": { "enum": ["static", "random", "approach"] },
        "dir": { "enum": ["down", "left", "right", "up"], "description": "Initial facing the character shows when this page spawns it; default down." },
        "moveRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "repeat", "skippable"],
          "properties": {
            "steps": { "type": "array", "items": { "$ref": "#/$defs/moveStep" }, "minItems": 1 },
            "repeat": { "type": "boolean" },
            "skippable": { "type": "boolean" }
          }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "pageCondition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "switch": { "type": "string" },
        "selfSwitch": { "enum": ["A", "B", "C", "D"] },
        "variable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "op", "value"],
          "properties": {
            "id": { "type": "string" },
            "op": { "enum": [">=", "<=", "==", "!="] },
            "value": { "type": "integer" }
          }
        },
        "item": { "type": "string" },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" },
          "description": "Compound AND gate: every condition in the list must hold, and it ANDs with the flat fields above. A {kind:'facing', dir} clause tests the player facing and makes a playerTouch page re-fire on a turn in place."
        }
      }
    },

    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "lines"],
          "properties": {
            "op": { "const": "text" },
            "lines": { "type": "array", "items": { "type": "string", "maxLength": 52 }, "minItems": 1, "maxItems": 4 },
            "cps": { "type": "integer", "minimum": 1, "maximum": 120, "description": "Chars per virtual second of typewriter reveal; default 30." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "prompt", "options"],
          "properties": {
            "op": { "const": "choices" },
            "prompt": { "type": "string", "maxLength": 52 },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "description": "T2-9: up to 8 options; the box scrolls a 4-row window once there are more than 4.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "commands"],
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
                }
              }
            },
            "cancel": {
              "type": "object",
              "additionalProperties": false,
              "required": ["commands"],
              "properties": { "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "value"],
          "properties": {
            "op": { "const": "switch" },
            "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "set"],
          "properties": {
            "op": { "const": "variable" },
            "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "set": {
              "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["op", "value"],
                  "properties": { "op": { "enum": ["set", "add", "sub"] }, "value": { "type": "integer" } } },
                { "type": "object", "additionalProperties": false, "required": ["op", "min", "max"],
                  "properties": { "op": { "const": "random" }, "min": { "type": "integer" }, "max": { "type": "integer" } } },
                { "type": "object", "additionalProperties": false, "required": ["op", "from"],
                  "description": "T2-16: the operand is another variable's live value (target OP source); div/mod by a source reading 0 leave the variable unchanged.",
                  "properties": { "op": { "enum": ["copy", "add", "sub", "mul", "div", "mod"] }, "from": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" } } }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "key", "value"],
          "properties": {
            "op": { "const": "selfSwitch" },
            "key": { "enum": ["A", "B", "C", "D"] },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "if", "then"],
          "properties": {
            "op": { "const": "if" },
            "if": { "$ref": "#/$defs/condition" },
            "then": { "type": "array", "items": { "$ref": "#/$defs/command" } },
            "else": { "type": "array", "items": { "$ref": "#/$defs/command" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "map", "x", "y"],
          "properties": {
            "op": { "const": "transfer" },
            "map": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/variableRef" }] },
            "x": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/variableRef" }] },
            "y": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/variableRef" }] },
            "dir": { "oneOf": [{ "enum": ["down", "left", "right", "up", "keep"] }, { "$ref": "#/$defs/variableRef" }] },
            "fade": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "target", "route"],
          "properties": {
            "op": { "const": "moveRoute" },
            "target": { "$ref": "#/$defs/routeTarget" },
            "wait": { "type": "boolean" },
            "route": {
              "type": "object",
              "additionalProperties": false,
              "required": ["steps", "repeat", "skippable"],
              "properties": {
                "steps": { "type": "array", "items": { "$ref": "#/$defs/moveStep" } },
                "repeat": { "type": "boolean" },
                "skippable": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "seconds"],
          "properties": {
            "op": { "const": "wait" },
            "seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "set", "amount"],
          "properties": {
            "op": { "const": "gold" },
            "set": { "enum": ["add", "sub"] },
            "amount": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "item", "set", "count"],
          "properties": {
            "op": { "const": "item" },
            "item": { "type": "string" },
            "set": { "enum": ["add", "sub"] },
            "count": { "type": "integer", "minimum": 1, "maximum": 99 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name"],
          "properties": {
            "op": { "const": "se" },
            "name": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
            "volume": { "type": "integer", "minimum": 0, "maximum": 100 },
            "pitch": { "type": "integer", "minimum": 50, "maximum": 150 }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "erase" } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "exit" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "lockInput" }
          },
          "description": "Cross-event input lock: while held the player cannot move and action presses start no event; autorun/parallel pages keep running. Cleared by unlockInput (or a map transfer)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "unlockInput" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "target", "x", "y"],
          "properties": {
            "op": { "const": "place" },
            "target": {
              "oneOf": [
                { "enum": ["this"] },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["event"],
                  "properties": { "event": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
                }
              ]
            },
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "dir": { "enum": ["down", "left", "right", "up"] }
          },
          "description": "Set Event Location: move this (or named) event to a tile, optionally facing a direction."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id"],
          "properties": {
            "op": { "const": "common" },
            "id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "id", "goods"],
          "properties": {
            "op": { "const": "shop" },
            "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "Namespaces this shop's persisted stock counters; must be stable across saves." },
            "goods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item"],
                "properties": {
                  "item": { "type": "string" },
                  "price": { "type": "integer", "minimum": 0, "description": "Overrides the item's own catalog price for buying at this shop only." },
                  "sellPrice": { "type": "integer", "minimum": 0, "description": "Overrides this shop's buy-back price for the item; absent falls back to floor(item.price/2)." },
                  "stock": { "type": "integer", "minimum": 0, "description": "Finite units this shop carries; a buy decrements it and a sell-back at this shop increments it. Absent means unlimited." },
                  "condition": { "$ref": "#/$defs/pageCondition", "description": "Reuses the page-condition clause shape: the row is hidden while it does not hold." }
                }
              }
            },
            "sell": { "type": "boolean", "description": "Default true. False hides the sell tab (MV 'purchase only')." },
            "sellList": { "enum": ["disable", "hide"], "description": "Default 'disable': an unsellable item lists dimmed and unconfirmable (MV parity). 'hide' omits it (Tuxemon parity)." }
          },
          "description": "T2-10 MV Shop Processing: buy from `goods` and (unless sell:false) sell any owned item, over gold and item counts."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "call", "args", "prompt"],
          "properties": {
            "op": { "const": "extChoice" },
            "call": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$" },
            "args": {},
            "prompt": { "type": "string", "maxLength": 52 },
            "cancel": { "type": "boolean", "description": "Default false. When true, cancel closes the modal and reports a cancel result." },
            "write": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "index": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                "key": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                "cancelled": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
              }
            }
          },
          "description": "Extension-provided dynamic choice list. Rows are recomputed from live state; selection optionally writes result variables and invokes the registered resolver."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "call", "args"],
          "properties": {
            "op": { "const": "ext" },
            "call": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$" },
            "args": {}
          },
          "description": "Namespaced game extension command. Its pure handler is registered when the session is created."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "setup"],
          "properties": {
            "op": { "const": "battle" },
            "setup": {},
            "onWin": { "type": "array", "items": { "$ref": "#/$defs/command" } },
            "onLose": { "type": "array", "items": { "$ref": "#/$defs/command" } },
            "onEscape": { "type": "array", "items": { "$ref": "#/$defs/command" } }
          },
          "description": "Battle Processing: park the event fiber while the registered battle reducer owns the scene, then run the matching optional result branch."
        }
      ]
    },

    "variableRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable"],
      "properties": {
        "variable": { "type": "string", "minLength": 1 }
      },
      "description": "Resolve this operand from the live event-variable bank."
    },

    "charTarget": {
      "oneOf": [
        { "const": "player" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "description": "The player or a map event by id."
    },
    "routeTarget": {
      "oneOf": [
        { "enum": ["player", "this"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "description": "Who a forced route drives: the player, the running event, or another map event."
    },
    "moveStep": {
      "oneOf": [
        {
          "enum": [
            "moveDown", "moveLeft", "moveRight", "moveUp",
            "stepForward",
            "faceDown", "faceLeft", "faceRight", "faceUp",
            "wait", "turnRandom"
          ]
        },
        { "const": "turnTowardPlayer" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["turnToward"],
          "properties": {
            "turnToward": { "$ref": "#/$defs/charTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pathTo"],
          "properties": {
            "pathTo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "retries": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approach"],
          "properties": {
            "approach": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target"],
              "properties": {
                "target": { "$ref": "#/$defs/charTarget" },
                "side": { "enum": ["down", "left", "right", "up"] },
                "distance": { "type": "integer", "minimum": 1 },
                "retries": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ],
      "description": "A move-route command. turnTowardPlayer faces the live player; {turnToward} faces a character; {pathTo} expands at the step start with a deterministic 4-way BFS, waits a bounded interval when unreachable or blocked, and allows 'retries' full replans (default 10) before continuing the route; {approach} pathfinds to the adjacent tile on the target's side (the side a step to the target enters from) and faces the target on arrival."
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "switch" },
            "id": { "type": "string" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "op", "value"],
          "properties": {
            "kind": { "const": "variable" },
            "id": { "type": "string" },
            "op": { "enum": [">=", "<=", "==", "!="] },
            "value": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key"],
          "properties": {
            "kind": { "const": "selfSwitch" },
            "key": { "enum": ["A", "B", "C", "D"] },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "count"],
          "properties": {
            "kind": { "const": "item" },
            "id": { "type": "string" },
            "count": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "amount"],
          "properties": {
            "kind": { "const": "gold" },
            "amount": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dir"],
          "properties": {
            "kind": { "const": "facing" },
            "dir": { "enum": ["down", "left", "right", "up"], "description": "The player facing. In a page condition it gates action/playerTouch pages by direction; in a playerTouch page it also re-fires when the player turns while standing in the area." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "worldIdle" },
            "negate": { "type": "boolean", "description": "Invert the derived world-idle result." }
          },
          "description": "True only while the map world is the unobstructed top-level state: no blocking event, input lock, modal, player route, transfer/fade, queued or active scene, fatal overlay, or host menu. Derived at the exact condition evaluation point and never saved."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "call", "args"],
          "properties": {
            "kind": { "const": "ext" },
            "call": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$" },
            "args": {}
          },
          "description": "Namespaced game extension condition, evaluated by a registered pure handler."
        }
      ]
    },
    "transferTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "x", "y", "dir"],
      "properties": {
        "map": { "type": "string" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "dir": { "enum": ["down", "left", "right", "up"] }
      }
    },
    "commonEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "commands"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string" },
        "trigger": { "enum": ["none", "parallel"] },
        "conditionSwitch": { "type": "string" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    }
  }
}
